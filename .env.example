# Copy to .env and replace this placeholder before starting the database.
POSTGRES_PASSWORD=replace-with-a-random-local-password
# Production hostname. Verify ops preflight and external readiness before enabling the public profile.
PUBLIC_HOSTNAME=localhost
# Production sign-in remains disabled until its providers are configured.
PUBLIC_BASE_URL=http://127.0.0.1:3000
EMAIL_ENABLED=false
MAIL_FROM=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sanitized image storage budget, shared by all contributors (512 MiB).
MEDIA_MAX_BYTES=536870912
# Public build-time map style URL; no API key is needed.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
